# =============================================================
#  SHATTERED SMP — DISCLOUD (Discord Bot) Environment Variables
#  Add each of these in: Discloud dashboard → your app → Environment
#  OR rename this file to .env before uploading your zip.
# =============================================================

# ── DISCORD BOT ──────────────────────────────────────────────
# From https://discord.com/developers/applications → your app → Bot
DISCORD_TOKEN=*** FILL IN — your bot token ***
DISCORD_CLIENT_ID=*** FILL IN — your Discord app Client ID ***

# Your server (guild) ID
DISCORD_GUILD_ID=1483399972211920896

# Role IDs — already configured for your server
DISCORD_ROLE_MODERATOR=1483400469752578244
DISCORD_ROLE_VIP=1507389264248180887
DISCORD_ROLE_DONOR=1490989013832699944
DISCORD_ROLE_MEMBER=1507389338571374794
# Create a separate Owner role in Discord and paste its ID here.
# If left blank, Owners will share the Moderator role on Discord.
DISCORD_ROLE_OWNER=*** FILL IN — your Owner role ID, or leave blank ***

# Channel IDs — copy these from Replit Secrets tab
DISCORD_CHANNEL_KILLS=*** COPY FROM REPLIT SECRETS ***
DISCORD_CHANNEL_DEATHS=*** COPY FROM REPLIT SECRETS ***
DISCORD_CHANNEL_ANNOUNCEMENTS=*** COPY FROM REPLIT SECRETS ***
DISCORD_CHANNEL_PUNISHMENTS=*** COPY FROM REPLIT SECRETS ***

# ── BACKEND API ───────────────────────────────────────────────
# Replace with your actual Render URL from Step 2 of the guide.
# The bot connects here via Socket.IO for rank sync.
# No trailing slash.
API_URL=https://YOUR_RENDER_APP.onrender.com

# ── DATABASE ──────────────────────────────────────────────────
# Same Neon connection string as the backend.
# Bot uses Prisma directly to query/update user records.
DATABASE_URL=*** FILL IN — your Neon connection string ***

# ── RUNTIME ───────────────────────────────────────────────────
NODE_ENV=production
